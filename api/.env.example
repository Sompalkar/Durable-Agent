# Copy to .env and fill in. The API refuses to boot with an invalid value.

NODE_ENV=development
PORT=4000

# Local Docker Mongo. Swap for an Atlas connection string in production:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=durable_agent

# Signs the session cookie. The Worker verifies with the SAME value, so if you
# change it here you must change AUTH_JWT_SECRET in backend/.dev.vars too.
# Generate:  openssl rand -base64 48
AUTH_JWT_SECRET=replace-me-with-at-least-32-characters-of-random

AUTH_TOKEN_TTL_DAYS=30

# Lets the Worker report finished turns back to this API. Never sent to a browser.
# Must match SERVICE_TOKEN in backend/.dev.vars.
# Generate:  openssl rand -hex 24
SERVICE_TOKEN=replace-me-with-at-least-16-characters

# Starting balance for a new account, in USD. A public signup link with an
# unlimited balance is an open tap on whatever API key is configured.
SIGNUP_CREDITS_USD=2

# Browsers allowed to send the cookie. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# Leave blank for localhost: the browser then scopes the cookie to the hostname
# and shares it across ports, which is how :3000, :4000 and :8787 see one login.
# COOKIE_DOMAIN=.yourdomain.com
